# ─── Supabase ───────────────────────────────────────────────────────────────
# Get these from: https://supabase.com/dashboard/project/_/settings/api
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# ─── Firebase ────────────────────────────────────────────────────────────────
# Get these from: https://console.firebase.google.com → Project Settings → Your apps
VITE_FIREBASE_API_KEY=your-firebase-api-key
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your-sender-id
VITE_FIREBASE_APP_ID=your-app-id

# ─── PHI Encryption (HIPAA) ──────────────────────────────────────────────────
# 32-character random string used for AES-256-GCM field-level encryption
# Generate with: openssl rand -base64 32
VITE_PHI_ENCRYPTION_KEY=your-32-char-minimum-secret-key-here
